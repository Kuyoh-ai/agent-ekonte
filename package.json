{
  "name": "agent-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stepper GUI for making videos with Claude agents: brief, storyboard, review, rough boards, production, export.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "render": "node engine/render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "gsap": "^3.15.0",
    "hono": "^4.13.9",
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.12.0",
    "roughjs": "^4.6.6",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
